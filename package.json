{
  "name": "spiritual-father-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "cross-env DB_USE_DIRECT=true drizzle-kit generate",
    "db:migrate": "cross-env DB_USE_DIRECT=true drizzle-kit migrate",
    "db:studio": "cross-env DB_USE_DIRECT=true drizzle-kit studio",
    "auth:migrate": "cross-env DB_USE_DIRECT=true npx auth@latest migrate --config ./src/lib/auth.ts --yes",
